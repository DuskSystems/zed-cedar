{
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,

  "file_scan_exclusions": ["**/.direnv", "**/.git"],

  "languages": {
    "Tree-sitter Query": {
      "language_servers": ["ts_query_ls"],
      "format_on_save": "on",
      "formatter": "language_server"
    },

    "Rust": {
      "language_servers": ["rust-analyzer"],
      "format_on_save": "on",
      "formatter": "language_server"
    },

    "Markdown": {
      "language_servers": ["vale", "typos"],
      "soft_wrap": "none"
    },

    "Nu": {
      "language_servers": ["nu", "nu-lint"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "nufmt",
          "arguments": ["--stdin"]
        }
      }
    },

    "Nix": {
      "language_servers": ["nixd", "nil"],
      "format_on_save": "on",
      "formatter": "language_server"
    },

    "TOML": {
      "language_servers": ["tombi"],
      "format_on_save": "on",
      "formatter": "language_server"
    }
  },

  "lsp": {
    "ts_query_ls": {
      "binary": {
        "path": "ts_query_ls"
      }
    },

    "rust-analyzer": {
      "binary": {
        "path": "rust-analyzer"
      },

      "initialization_options": {
        "cargo": {
          "targetDir": true
        },
        "check": {
          "command": "clippy"
        },
        "checkOnSave": true
      }
    },

    "nixd": {
      "binary": {
        "path": "nixd"
      },

      "settings": {
        "formatting": {
          "command": ["nixfmt", "--width=120"]
        }
      }
    },

    "nil": {
      "binary": {
        "path": "nil"
      }
    },

    "tombi": {
      "binary": {
        "path": "tombi",
        "arguments": ["lsp"]
      }
    },

    "typos": {
      "binary": {
        "path": "typos-lsp"
      }
    },

    "vale": {
      "binary": {
        "path": "vale-ls"
      }
    },

    "nu": {
      "binary": {
        "path": "nu",
        "arguments": ["--lsp"]
      }
    },

    "nu-lint": {
      "binary": {
        "path": "nu-lint",
        "arguments": ["--lsp", "--config", ".nu-lint.toml"]
      }
    }
  }
}
